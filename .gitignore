# Ambiente virtual
.venv/
venv/
env/

# Variáveis de ambiente / credenciais
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Resultados: versiona somente a estrutura com .gitkeep
resultados/**
!resultados/**/
!resultados/**/.gitkeep

# Logs de execução: versiona somente a estrutura com .gitkeep
logs/**
!logs/**/
!logs/**/.gitkeep

# Estado persistente local: versiona somente a estrutura com .gitkeep
estado/**
!estado/**/
!estado/**/.gitkeep

# Caso ainda exista resultado antigo dentro de bot
bot/resultados/

# Perfis Chromium: versiona somente .gitkeep
perfis/*/chromium/*
!perfis/*/chromium/.gitkeep

# Perfis antigos
bot/**/perfil_real/
bot/**/perfil_zendesk/
bot/**/perfil_jadlog/
bot/**/chromium/

# Temporários
*.tmp
*.temp
*.part
~$*.xlsx
~$*.xls
*.log

# Playwright
playwright-report/
test-results/
